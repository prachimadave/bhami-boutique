# Bhami Craft Boutique - Environment Configuration Template
# Copy this file to .env and set your production values.
# NEVER commit the actual .env file or real credentials to Git.

# 1. Production Admin Login Credentials
# Set these in your hosting environment (Vercel, Render, or production server).
# When configured, these production credentials authenticate your administrative dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_production_password_here

# Optional: Provide a precomputed SHA-256 hash instead of a plaintext password in env
# ADMIN_PASSWORD_HASH=
# ADMIN_SALT=

# 2. Demo Mode Control
# In development/demo environments, default demo credentials ('admin' / 'bhami@craft2026') are permitted.
# Set to 'false' in production to strictly disable demo login fallback:
ALLOW_DEMO_LOGIN=false

# 3. Cryptographic Session Secret
# Used for cryptographically secure session handling
SESSION_SECRET=bhami_random_session_secret_change_in_production

# 4. Boutique WhatsApp Helpline Number (country code without '+' followed by phone number)
BOUTIQUE_WHATSAPP_PHONE=919800000000

# 5. Hosted Database URL (for Vercel/Postgres deployment)
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
