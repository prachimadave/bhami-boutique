# Bhami Craft Boutique - Environment Configuration
# Copy this file to .env and set your production values.

# Production Admin Login Credentials
# Set these in your environment (or Vercel / Render project settings)
# When set, they override default demo credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Cryptographic Session Secret
SESSION_SECRET=bhami_random_session_secret_change_in_production

# Boutique WhatsApp Helpline Number (country code without '+' followed by phone number)
BOUTIQUE_WHATSAPP_PHONE=919800000000

# Hosted Database URL (for Vercel/Postgres deployment)
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
